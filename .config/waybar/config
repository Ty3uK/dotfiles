{
    "modules-left": ["hyprland/workspaces", "river/tags"],
    "modules-center": ["mpris"],
    "modules-right": ["tray", "group/misc", "group/stats", "clock", "custom/power"],
    "mpris": {
        "format-playing": "<span size='large'></span>  {title} - {artist}",
        "format-paused": "<span size='large'></span>  {title} - {artist}",
        "title-len": 40,
        "tooltip-format": "{title}\n{artist}\n{album}\n{player}"
    },
    "clock": {
        "format": "{:%a %d. %b %I:%M%p}"
    },
    "group/misc": {
        "modules": ["hyprland/language", "battery", "network", "wireplumber"],
        "orientation": "horizontal"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "🇺🇸",
        "format-ru": "🇷🇺"
    },
    "network": {
        "format-wifi": "<span size='large'></span>",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰈂",
        "tooltip-format-wifi": "{ifname}\n{essid}\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "format": "<span size='large'>{icon}</span>",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Capacity:     {capacity}%\nTime to full: {time}"
    },
    "wireplumber": {
        "format": "<span size='large'></span>",
        "format-muted": "<span size='large'></span>",
        "on-click": "pavucontrol"
    },
    "cpu": {
        "interval": 5,
        "format": "<span rise='1000'>󰻠</span>  {usage}%"
    },
    "memory": {
        "interval": 30,
        "format": "<span size='large'></span>  {percentage}%",
        "tooltip": true,
        "tooltip-format": "Memory: {used}/{total}GB\nSwap: {swapUsed}/{swapTotal}GB"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "format": " {temperatureC}°C",
        "tooltip": false
    },
    "group/stats": {
        "modules": ["cpu", "memory", "temperature"],
        "orientation": "horizontal"
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.local/bin/powermenu"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 15
    },
    "river/tags": {
        "hide-vacant": true
    }
}
