{
    "modules-right": ["tray", "hyprland/language", "clock", "custom/power"],
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "hyprland/language": {
        "format-en": "🇺🇸",
        "format-ru": "🇷🇺"
    },
    "clock": {
        "format": "{:%I:%M%p}"
    },
    "custom/power": {
		"format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
